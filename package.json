{
  "name": "pages",
  "private": true,
  "scripts": {
    "format": "prettier --ignore-path .gitignore --write .",
    "format:check": "prettier --ignore-path .gitignore --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "build:script": "tsc",
    "build:copy": "mkdir -p dist && cp -r pages/* dist/",
    "build": "npm run build:copy && npm run build:script",
    "serve": "serve dist/"
  },
  "devDependencies": {
    "@types/p5": "^1.7.7",
    "@types/three": "^0.186.0",
    "mathjs": "^15.2.0",
    "p5": "^2.3.3",
    "prettier": "^3.9.8",
    "three": "^0.186.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "serve": "^14.2.6"
  }
}
